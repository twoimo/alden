+def _prefer_named_source_titles(store, rows, ranked, plans, projects, limit,
+                                body_preferred, budget, cancelled):
+    """Candidate: exact named-source lookup, explicitly not body grounding."""
+    matched = set()
+    for row in rows.values():
+        _check(cancelled)
+        if (row['id'] not in body_preferred and row['body'].strip()
+                and all(korean_literal_matches(plan, row['label'], '') for plan in plans)):
+            matched.add(row['id'])
+    ordered = list(dict.fromkeys(identity for identity, _ in ranked if identity in matched))
+    ordered.extend(sorted(matched - set(ordered)))
+    preferred, checked = set(), 0
+    with store.database() as db:
+        for identity in ordered[:budget]:
+            _check(cancelled)
+            row = rows[identity]
+            source, metadata, _memberships = _verified_source(db, store, row, projects)
+            checked += 1
+            if content_evidence_class(metadata, row['body'], source=source,
+                                      body_source=row['body_source']) == 'content_candidate':
+                preferred.add(identity)
+    ranked_ids = {identity for identity, _ in ranked}
+    candidates = ranked + [(identity, 0.) for identity in ordered
+                           if identity in preferred and identity not in ranked_ids]
+    candidates.sort(key=lambda item: 0 if item[0] in body_preferred else
+                    1 if item[0] in preferred else 2)
+    return candidates[:limit], preferred, {'matched': len(matched), 'verified': checked,
+        'preferred': len(preferred), 'verification_limit': budget,
+        'truncated': len(ordered) > checked, 'meaning': 'source_title_lookup_not_body_grounding'}
