+def _original_word_plans(query):
+    # FTS recall may prune words; complete source-title validation may not.
+    words = list(dict.fromkeys(re.findall(r'[0-9a-z가-힣]+', query.lower())))
+    if not 1 <= len(words) <= 24 or any(len(word) > 64 for word in words):
+        return None
+    return [((word,),) for word in words]
+
+
+def _retained_excerpt(body, plans, capacity, cancelled):
+    """Return exact slices of the verified NFC/LF body, with codepoint offsets.
+
+    At most 128 occurrences per query word are examined. A bounded literal
+    window is a presentation aid, never semantic relevance or fact validation.
+    ASCII-only case translation keeps coordinates stable for Unicode bodies.
+    """
+    capacity = max(0, capacity)
+    if len(body) <= capacity:
+        return body, [(0, len(body))] if body else []
+    folded = body.translate(str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZ',
+                                        'abcdefghijklmnopqrstuvwxyz'))
+    events = []
+    for index, plan in enumerate(plans or []):
+        word = plan[0][0]
+        offset, accepted, scanned = folded.find(word), 0, 0
+        while offset >= 0 and accepted < 128 and scanned < 512:
+            _check(cancelled)
+            end = offset + len(word)
+            left = not word[0].isdigit() or offset == 0 or not folded[offset-1].isdigit()
+            right = not word[-1].isdigit() or end == len(body) or not folded[end].isdigit()
+            if left and right:
+                events.append((offset, end, index)); accepted += 1
+            scanned += 1
+            offset = folded.find(word, offset + 1)
+    if not events or not capacity:
+        return body[:capacity], [(0, min(len(body), capacity))] if capacity else []
+    events.sort()
+    counts, left, best = {}, 0, None
+    wanted = len({event[2] for event in events})
+    for right, event in enumerate(events):
+        _check(cancelled)
+        counts[event[2]] = counts.get(event[2], 0) + 1
+        while len(counts) == wanted:
+            width = max(e[1] for e in events[left:right+1]) - events[left][0]
+            if best is None or width < best[0]:
+                best = (width, left, right)
+            identity = events[left][2]
+            counts[identity] -= 1
+            if counts[identity] == 0:
+                del counts[identity]
+            left += 1
+    selected = {}
+    for start, end, index in events[best[1]:best[2]+1]:
+        selected.setdefault(index, (start, end))
+    core = sorted(selected.values())
+    def merge(values):
+        ranges = []
+        for start, end in sorted(values):
+            if ranges and start <= ranges[-1][1]:
+                ranges[-1] = (ranges[-1][0], max(end, ranges[-1][1]))
+            else:
+                ranges.append((start, end))
+        return ranges
+    separator = '\n[…생략…]\n'
+    def size(ranges):
+        return sum(end-start for start, end in ranges) + max(0, len(ranges)-1)*len(separator)
+    ranges = merge(core)
+    if size(ranges) > capacity:
+        # A too-small budget must report partial coverage, not drop query words
+        # from the matching contract or invent a complete passage.
+        ranges = []
+        for start, end in core:
+            room = capacity - size(ranges) - (len(separator) if ranges else 0)
+            if room <= 0:
+                break
+            ranges = merge(ranges + [(start, min(end, start+room))])
+    low, high = 0, 120
+    base = ranges
+    while low <= high:
+        _check(cancelled)
+        padding = (low+high)//2
+        expanded = merge([(max(0,start-padding), min(len(body),end+padding))
+                          for start,end in base])
+        if size(expanded) <= capacity:
+            ranges, low = expanded, padding+1
+        else:
+            high = padding-1
+    return separator.join(body[start:end] for start,end in ranges), ranges
+
