+def _voice_compact_retrieved_fact(fact, proof, query, token):
+    """Candidate: preserve literal coverage and coordinates under the voice cap.
+
+    Projection ranges refer to the retrieved fact, while body_excerpt continues
+    to describe the independently verified source body. Neither is semantic
+    completeness or source truth.
+    """
+    excerpt = proof.get('body_excerpt')
+    if (len(fact) <= 600 or proof.get('source_kind') != 'collected_source'
+            or proof.get('provenance_valid') is not True or not isinstance(excerpt, dict)):
+        return fact[:600], None
+    from alden_collection_retrieval import (CONTEXT_EXCERPT_POLICY,
+                                           _original_word_plans, _retained_excerpt)
+    if excerpt.get('policy') != CONTEXT_EXCERPT_POLICY:
+        return fact[:600], None
+    token.raise_if_cancelled()
+    text, ranges = _retained_excerpt(fact, _original_word_plans(query), 600, token.is_cancelled)
+    token.raise_if_cancelled()
+    return text, {'schema': 1, 'policy': 'voice-retained-fact-slices-candidate-v1',
+        'basis': 'retrieved_fact_before_voice_compaction', 'unit': 'unicode_codepoints',
+        'fact_sha256': hashlib.sha256(fact.encode('utf-8')).hexdigest(), 'fact_chars': len(fact),
+        'ranges': [{'start': start, 'end': end} for start, end in ranges],
+        'meaning': 'retained literal slices; not semantic completeness or source truth'}
+
